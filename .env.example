# Source Database Configuration (Leap BFF OLTP Database)
DB_HOST=<ip address>
DB_PORT=<port>
DB_NAME=westlakersdb
DB_USERNAME=postgres
DB_PASSWORD=<password>

# Analytics Database Configuration (OLAP/Data Warehouse)
ANALYTICS_DB_HOST=<ip address>
ANALYTICS_DB_PORT=<port>
ANALYTICS_DB_NAME=westlakersdb_olap
ANALYTICS_DB_USERNAME=postgres
ANALYTICS_DB_PASSWORD=<password>

# Security Configuration
SECURITY_USER_NAME=devuser
SECURITY_USER_PASSWORD=<password>

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=etl_pipeline.log

# ETL Configuration
BATCH_SIZE=1000
ENABLE_DATA_PROFILING=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=8100
REDIS_TIMEOUT=2000ms
REDIS_MAX_ACTIVE=8
REDIS_MAX_IDLE=8
REDIS_MIN_IDLE=0
REDIS_MAX_WAIT=-1ms